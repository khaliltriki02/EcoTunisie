  <rdf:Description rdf:about="http://example.org/eco-tourism#Famille">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Famille</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/eco-tourism#Voyageur"/>
