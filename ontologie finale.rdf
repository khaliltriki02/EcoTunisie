    <rdfs:label>contientLieu</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/eco-tourism#Destination"/>
    <rdfs:range rdf:resource="http://example.org/eco-tourism#LieuTouristique"/>
    <owl:inverseOf rdf:resource="http://example.org/eco-tourism#situeDans"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/eco-tourism#contient"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/eco-tourism#situeDans">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
