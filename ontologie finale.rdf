<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="http://example.org/eco-tourism#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/eco-tourism#PrefGastro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/eco-tourism#PréférenceGastronomique"/>
    <rdfs:label>PrefGastro</rdfs:label>
    <description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuisine locale</description>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/eco-tourism#RecommandationEco">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/eco-tourism#Recommandation"/>
    <rdfs:label>RecommandationEco</rdfs:label>
    <description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Séjour écoresponsable à Hammamet</description>
    <ecoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.92</ecoScore>
    <note rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.7</note>
    <baseeSur rdf:resource="http://example.org/eco-tourism#PrefNature"/>
    <recommandeVoyage rdf:resource="http://example.org/eco-tourism#Hammamet"/>
    <recommandeActivite rdf:resource="http://example.org/eco-tourism#RandonneeZaghouan"/>
    <recommandeHebergement rdf:resource="http://example.org/eco-tourism#EcolodgeTestour"/>
    <recommandeTransport rdf:resource="http://example.org/eco-tourism#TrainSNCFT"/>
    <recommandeRestauration rdf:resource="http://example.org/eco-tourism#RestaurantBioTunis"/>
    <recommandeLieu rdf:resource="http://example.org/eco-tourism#Carthage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/eco-tourism#ecoScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>ecoScore</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/eco-tourism#accessibilitePMR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>accessibilitePMR</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/eco-tourism#LieuTouristique"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/eco-tourism#nom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>nom</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/eco-tourism#proposeActivite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>proposeActivite</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/eco-tourism#Destination"/>
    <rdfs:range rdf:resource="http://example.org/eco-tourism#Activité"/>
