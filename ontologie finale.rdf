  <rdf:Description rdf:about="http://example.org/eco-tourism#Hammamet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/eco-tourism#DestinationCôtière"/>
    <nom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hammamet</nom>
    <pays rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tunisie</pays>
    <accessiblePar rdf:resource="http://example.org/eco-tourism#TrainSNCFT"/>
    <contient rdf:resource="http://example.org/eco-tourism#PlageHammamet"/>
    <possedeHebergement rdf:resource="http://example.org/eco-tourism#HotelHammamet"/>
    <proposeActivite rdf:resource="http://example.org/eco-tourism#YogaHammamet"/>
    <possedeRestauration rdf:resource="http://example.org/eco-tourism#RestaurantBioTunis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/eco-tourism#desserviPar">
